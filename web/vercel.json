{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite","buildCommand":"npm run build","outputDirectory":"dist","installCommand":"npm ci",
  "headers":[
    {"source":"/(.*)","headers":[
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; worker-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"},
      {"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/model/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
